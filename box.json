{
    "main": "vendor/autoload.php",
    "output": "homestead.phar",
    "force-autodiscovery": true,
    "directories": ["vendor", "engine"],

    "stub": false,
    "compression": "GZ",

    "exclude-dev-files": true,
    "check-requirements": false,

    "blacklist": [
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "config",
        "icons",
        ".box"
    ],
    "finder": [
        {
            "notName": "/LICENSE|.*\\.md|.*\\.dist|Makefile|composer\\.json|composer\\.lock/",
            "exclude": [
                "doc",
                "test",
                "tests",
                "vendor-bin"
            ],
            "in": "vendor"
        },
        {
            "name": "composer.json",
            "in": "."
        }
    ]
}