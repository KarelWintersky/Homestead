{
    "main": "index.php",
    "output": "index.phar",
    "compression": "GZ",

    "compactors": [
        "KevinGH\\Box\\Compactor\\Php",
        "KevinGH\\Box\\Compactor\\Json"
    ],

    "directories": [
        "engine",
        "vendor",
        "templates",
        "assets"
    ],

    "files": [
        "index.php",
        "composer.json"
    ],
    "files-bin": [
        "templates/main.php",
        "assets/styles.css",
        "assets/scripts.js"
    ],

    "finder": [
        {
            "name": "*.php",
            "in": "engine"
        },
        {
            "name": "*.html",
            "in": "templates"
        },
        {
            "name": ["*.css", "*.js", "*.jpg", "*.png", "*.svg", "*.ico"],
            "in": "assets"
        },
        {
            "name": "*.php",
            "in": "vendor",
            "notName": "/LICENSE|.*\\.md|.*\\.dist|Makefile|composer\\.json|composer\\.lock/",
            "exclude": [
                "doc",
                "test",
                "tests",
                "vendor-bin",
                ".gitignore",
                ".coveralls.yml",
                ".php_cs.dist",
                ".travis.yml",
                "composer.lock",
                "config.example.php",
                "phpstan.neon",
                "phpunit.xml"
            ]
        }
    ],

    "blacklist": [
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "config",
        "icons",
        ".box"
    ],

    "shebang": false,
    "check-requirements": false
}