{
    "name": "karelwintersky/homestead",
    "description": "Homestead - simple links and widgets dashboard",
    "type": "project",
    "authors": [
        {
            "name": "Karel Wintersky",
            "email": "karel@wintersky.ru"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "vendor-dir": "vendor",
        "platform-check": false
    },
    "autoload": {
        "psr-4": {
            "Homestead\\": "engine/"
        }
    },
    "require": {
        "php": "^8",
        "ext-redis": "*",
        "ext-simplexml": "*",
        "symfony/yaml": "^7.2"
    }
}
